# Core Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=portal.example.com,.portal.example.com
ROOT_DOMAIN=portal.example.com

# MySQL is configured in project/settings.py for the local `profiler` database.
# Replace the local root account there with a least-privilege database user
# before deploying to production.

# Redis cache
CACHE_BACKEND=django_redis.cache.RedisCache
CACHE_LOCATION=redis://redis:6379/1
CACHE_TIMEOUT=300

# SMTP
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Portal <no-reply@example.com>

# Keep synchronous page-view logging disabled at high traffic.
ANALYTICS_MIDDLEWARE_ENABLED=False

# Existing payment integration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
